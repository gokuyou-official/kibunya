# Firebase Web SDK config
# ----------------------------------------------------------------------
# 取得方法:
#   1) firebase login
#   2) firebase projects:create kibunya-app --display-name "キブンヤ"
#   3) firebase use kibunya-app
#   4) firebase apps:create WEB kibunya-web
#   5) firebase apps:sdkconfig WEB --json
# 出力された firebaseConfig の各キーを下に貼り付けてください。
#
# このファイル (.env.example) はコミットされます。実値は .env に書き、
# .env は .gitignore 済みなのでコミットされません。
# ----------------------------------------------------------------------

# firebaseConfig.apiKey
EXPO_PUBLIC_FIREBASE_API_KEY=

# firebaseConfig.authDomain (通常は <projectId>.firebaseapp.com)
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=kibunya-app.firebaseapp.com

# firebaseConfig.projectId
EXPO_PUBLIC_FIREBASE_PROJECT_ID=kibunya-app

# firebaseConfig.storageBucket (通常は <projectId>.appspot.com)
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=kibunya-app.appspot.com

# firebaseConfig.messagingSenderId (数字のみ)
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=

# firebaseConfig.appId (例: 1:1234567890:web:abcdef123456)
EXPO_PUBLIC_FIREBASE_APP_ID=

# firebaseConfig.measurementId (Google Analytics 用、任意)
# 例: G-XXXXXXXXXX
EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=

# ----------------------------------------------------------------------
# App Store Connect API (TestFlight 管理スクリプト用)
# ----------------------------------------------------------------------
# ISSUER_ID / KEY_ID は App Store Connect → Users and Access → Keys から取得。
# P8 キーは同画面から1回だけダウンロード可能 (AuthKey_<KEY_ID>.p8)。
#
# 秘密鍵の渡し方は2通り (どちらか一方):
#   1) ASC_P8_KEY      — P8 本文 (PEM) を直接入れる (CI / GitHub Secrets 推奨)
#   2) ASC_P8_KEY_PATH — ローカルファイルパス (個人開発用)
# scripts/asc-secrets/ 配下の .p8 は .gitignore (*.p8) で除外済。
ASC_ISSUER_ID=00000000-0000-0000-0000-000000000000
ASC_KEY_ID=ABCDEFGHIJ
ASC_P8_KEY_PATH=./scripts/asc-secrets/AuthKey_ABCDEFGHIJ.p8
# ASC_P8_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
ASC_APP_ID=0000000000
ASC_BUNDLE_ID=com.example.app
